PORT=5050
TMDB_API_KEY=
OMDB_API_KEY=
MOVIE_SECRET=
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Public HTTPS origin for the viewing guide canonical and sitemap (no path).
SITE_URL=

# PostgreSQL — Express admin dashboard, sessions, provider config (aftershow_express schema)
# Use the Neon pooler URL for the web service. ISAIDUB and MOVIEZDA URLs are
# stored in the database and managed via the admin dashboard — no env vars needed.
EXPRESS_DATABASE_URL=postgresql://...@.../neondb?sslmode=require

# Exact additional HTTPS origins approved for curated custom links only.
# Provider origins (isaidub, moviezda) are managed in the admin dashboard.
APPROVED_ORIGINS=
